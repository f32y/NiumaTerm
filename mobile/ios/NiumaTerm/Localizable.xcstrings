    },
    "%u commands run when the turn ends.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%u 条命令将在本轮结束后运行。"
          }
        }
      }
    },
    "/": {
      "shouldTranslate": false
    },
    ">_": {
      "shouldTranslate": false
    },
    "A command is starting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有命令正在启动。"
          }
        }
      }
    },
    "A computer sends these once this phone has been away from it for five minutes, and stops when you are back at the computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机离开电脑五分钟后，电脑会发送这些通知；回到电脑前后即停止。"
          }
        }
      }
    },
    "Access key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问密钥"
          }
        }
      }
    },
