{
  "sourceLanguage": "en",
  "strings": {
    "%@ already read that message.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已读取了那条消息。"
          }
        }
      }
    },
    "%@ asks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 提问"
          }
        }
      }
    },
    "%@ asks %lld questions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 提出了 %2$lld 个问题"
          }
        }
      }
    },
    "%@ context": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文 %@"
          }
        }
      }
    },
    "%@ did not accept the answer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未接受该回答。"
          }
        }
      }
    },
    "%@ has no agent profiles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有智能体配置。"
          }
        }
      }
    },
    "%@ is out of reach": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@"
          }
        }
      }
    },
    "%@ is still starting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在启动。"
          }
        }
      }
    },
    "%@ needs approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要批准"
          }
        }
      }
    },
    "%@ no longer lists this session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再列出此会话。"
          }
        }
      }
    },
    "%@ restarts on %@ with an empty conversation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将在 %2$@ 上以空白对话重新开始。"
          }
        }
      }
    },
    "%@ took this session back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已收回此会话"
          }
        }
      }
    },
    "%@ used · %lld%% left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %1$@ · 剩余 %2$lld%%"
          }
        }
      }
    },
    "%@ · Asleep": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 休眠中"
          }
        }
      }
    },
    "%lld images": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld image"
