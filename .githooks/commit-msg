#!/bin/sh
set -eu

msg_file=${1:?commit message file required}

# Commit messages are English-only, so every byte must be printable ASCII.
# The C locale makes grep treat UTF-8 continuation bytes as non-printable,
# which catches CJK text as well as smart quotes and dashes.
body=$(sed -e '/^# ------------------------ >8/,$d' -e '/^#/d' "$msg_file")

# Literal escape spellings indicate that a shell passed formatting text
# without interpreting it, leaving a malformed commit message.
escaped_controls=$(printf '%s\n' "$body" | grep -nE '\\[nrt]' || true)
if [ -n "$escaped_controls" ]; then
    cat >&2 <<EOF
commit-msg: literal escaped control sequences are not allowed

Use real line breaks or whitespace instead.

Offending lines:
$escaped_controls
EOF
    exit 1
fi

if printf '%s\n' "$body" | LC_ALL=C grep -nq '[^[:print:][:space:]]'; then
    offending=$(printf '%s\n' "$body" | LC_ALL=C grep -n '[^[:print:][:space:]]')
    cat >&2 <<EOF
commit-msg: commit messages must be written in English (ASCII only)

Offending lines:
$offending
EOF
    exit 1
fi

# A present Co-Authored-By trailer must name the model that did the work
# (AGENTS.md), so the credit records the actual model ID instead of a vendor
# or human label. Model IDs are lowercase and versioned, so the name part
# must contain a '-' or '.' separator (e.g. deepseek-v4-flash); a bare label
# like "Claude" or "Codex" does not pass. A bracketed suffix carries the
# variant an agent reports alongside the ID, such as the context window in
# claude-opus-5[1m].
coauthor_pattern='^Co-Authored-By: [a-z0-9][a-z0-9._-]*[-.][a-z0-9._-]*(\[[a-z0-9._-]+\])? <noreply@[a-z0-9][a-z0-9.-]*\.[a-z]{2,}>$'
bad_coauthors=$(printf '%s\n' "$body" | grep -E '^Co-Authored-By:' | grep -Ev "$coauthor_pattern" || true)
if [ -n "$bad_coauthors" ]; then
    cat >&2 <<EOF
commit-msg: Co-Authored-By must name the model ID

Expected:
  Co-Authored-By: <MODEL_ID> <noreply@<vendor>.com>
Example:
  Co-Authored-By: deepseek-v4-flash <noreply@deepseek.com>

Offending lines:
$bad_coauthors
EOF
    exit 1
fi

# A Verification section names the specific changed behavior that was exercised
# and its observed result. A command invocation does not carry that information.
# Only the section body is scanned, so a subject or body line about one of these
# commands is still fine.
verification_commands=$(
    printf '%s\n' "$body" | awk '
        /^[Vv]erification/ { in_section = 1 }
        !in_section { next }
        tolower($0) ~ /cargo (\+[a-z0-9._-]+ )?(check|test|fmt|clippy|build)/ ||
        tolower($0) ~ /rustfmt|cargo-fmt|clippy::/ ||
        tolower($0) ~ /compil(e|es|ed|ation)/ {
            printf "%d: %s\n", NR, $0
        }
    '
)
if [ -n "$verification_commands" ]; then
    cat >&2 <<EOF
commit-msg: Verification must name the specific tested behavior

A command invocation does not show which changed behavior was exercised.
Name the specific scenario and observed result instead of citing cargo check,
cargo test, cargo fmt, cargo clippy, cargo build or compiling. Drop the
Verification section when there is no behavior-specific result to report.

Offending lines:
$verification_commands
EOF
    exit 1
fi

subject=$(sed -n '/^#/!{/./{p;q;}}' "$msg_file")

# 60/80 rule: keep the subject under 60 chars and wrap body lines at 80.
# Trailer-shaped lines (Key: value) are exempt from the body wrap, matching
# git's own behavior with generated trailers like Signed-off-by.
subject_len=${#subject}
if [ "$subject_len" -gt 60 ]; then
    cat >&2 <<EOF
commit-msg: subject exceeds 60 characters

Keep the subject to a single line of at most 60 characters; put detail in
the body.

Actual ($subject_len chars):
  $subject
EOF
    exit 1
fi

long_body=$(
    printf '%s\n' "$body" | awk '
        !subject_seen {
            if (length($0) > 0) { subject_seen = 1; next }
        }
        /^[A-Za-z][A-Za-z0-9-]+: / { next }
        length($0) > 80 { printf "%d: %d chars: %s\n", NR, length($0), $0 }
    '
)
if [ -n "$long_body" ]; then
    cat >&2 <<EOF
commit-msg: body lines must be wrapped at 80 characters

Offending lines:
$long_body
EOF
    exit 1
fi

pattern='^(feat|fix|refactor|docs|perf|test|chore|build|ci|style|revert|lint)(\([a-z0-9_.-]+\))?: [a-z0-9].*$'

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    exit 0
fi

cat >&2 <<EOF
commit-msg: invalid commit subject

Expected:
  <type>(optional-scope): <lowercase subject>

Allowed types:
  feat, fix, refactor, docs, perf, test, chore, build, ci, style, revert, lint

Examples:
  feat(app): add titlebar token totals
  fix(lint): suppress noisy clippy warnings
  lint: apply cargo fmt

Actual:
  $subject
EOF

exit 1
