#!/bin/sh
set -eu

collect_staged_code_files() {
    printf '%s\n' "$staged_files" |
        awk -v protected="$protected_paths" -v code_path="$code_file_pattern" '
            $0 ~ protected { next }
            $0 ~ code_path { print }
        '
}

collect_added_comment_lines() {
    git diff --cached --diff-filter=ACMR -U0 |
        awk -v protected="$protected_paths" -v code_path="$code_file_pattern"             -v generated="$generated_paths" '
            /^\+\+\+ b\// {
                file = substr($0, 7)
                code = file !~ protected && file !~ generated && file ~ code_path
                next
            }
            # An unescaped '/' inside a bracket expression closes the regex
            # literal in awk implementations that lex '/.../' before parsing
            # it, so the doc-comment markers are left off: '//' already
            # matches '///' and '//!' because nothing anchors the end.
            code && /^\+[[:space:]]*(\/\/|#|\/\*|\*|<!--)/ { print file ": " $0 }
        '
}

check_ai_docs_are_separate() {
    if [ -z "$protected_files" ] || [ -z "$code_files" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: AI docs must be committed separately

Protected paths:
$protected_files

Code files:
$code_files
EOF
    failed=1
}

check_no_incomplete_openspec_changes() {
    incomplete_spec_files=$(git diff --cached --name-only --diff-filter=ACMR |
        grep -E '^openspec/changes/' |
        grep -Ev '^openspec/changes/archive/' || true)
    if [ -z "$incomplete_spec_files" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: unfinished spec documents cannot be committed

$incomplete_spec_files
EOF
    failed=1
}

check_third_party_dirs_are_separate() {
    for isolated_path in third_party/gpui 'third_party/gpui-(kit|component)'; do
        isolated_files=$(printf '%s\n' "$staged_files" | grep -E "^$isolated_path/" || true)
        other_files=$(printf '%s\n' "$staged_files" | grep -Ev "^$isolated_path/" || true)
        if [ -z "$isolated_files" ] || [ -z "$other_files" ]; then
            continue
        fi

        cat >&2 <<EOF
pre-commit: $isolated_path must be committed separately

Files under $isolated_path:
$isolated_files

Other staged files:
$other_files
EOF
        failed=1
    done
}

check_protected_paths_on_main() {
    if [ "$branch" != "main" ] || [ -z "$protected_files" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: refusing protected-path commit on main

$protected_files
EOF
    failed=1
}

check_no_ai_slop_marker() {
    # Words that collide with real identifiers or terminal terms (text
    # shaping, render surfaces, arithmetic carry, bridges) stay out of
    # this list, because it matches whole words in code as well as prose.
    slop_markers='ponytail|seam|fact|parity|envelope|wire|contract'
    slop_markers="$slop_markers|rather than|which is what|says nothing"
    slop_markers="$slop_markers|carries|carried|carrying"
    slop_markers="$slop_markers|lands|landed|landing|travels|travelled"
    slop_markers="$slop_markers|surfaced|surfacing|lifted|hoisted|funnels"
    slop_markers="$slop_markers|honest|honestly|worth|ordinary|actually"
    slop_markers="$slop_markers|deliberately|intentionally|explicitly"
    slop_markers="$slop_markers|vocabulary|authoritative|plumbing|scaffolding"
    slop_markers="$slop_markers|load-bearing|knobs?|lockstep|footprint"
    slop_markers="$slop_markers|belt-and-braces|gate|gating"
    added=$(git diff --cached --diff-filter=ACMR -U0 |
        awk -v generated="$generated_paths" '
            /^\+\+\+ b\// {
                file = substr($0, 7)
                vendored = file ~ generated
                # License notices must retain the original upstream wording.
                license_file = tolower(file) ~ /(^|\/)license([.](md|txt|rst))?$/
                # The files that define the banned list have to spell it out.
                word_list = file ~ /^(\.githooks\/pre-commit|AGENTS[.]md)$/
                print "@@"
                next
            }
            # A hunk break ends the run of lines a wrapped phrase may span.
            /^@@/ { print "@@"; next }
            !vendored && !license_file && !word_list && /^\+/ {
                # Cargo lock package and dependency names use upstream metadata.
                if (file ~ /(^|\/)Cargo[.]lock$/ && \
                    ($0 ~ /^\+name = "[^"]+"[[:space:]]*$/ || \
                     $0 ~ /^\+[[:space:]]+"[^"]+",?[[:space:]]*$/)) {
                    print "@@"
                    next
                }
                print file ": " $0
            }
        ')
    # Identifiers are split at underscores and lower-to-upper case changes, so
    # `carries_id` and `LandingZone` match the same words as plain prose.
    # Multi-word phrases are also matched across two consecutive added lines,
    # because comment wrapping often breaks "rather than" between lines.
    slop=$(printf '%s\n' "$added" | awk -v markers="$slop_markers" '
        BEGIN {
            n = split(markers, list, "|")
            phrases = ""
            for (i = 1; i <= n; i++) {
                if (list[i] ~ / /) phrases = phrases (phrases == "" ? "" : "|") list[i]
            }
        }
        $0 == "@@" { tail = ""; next }
        {
            # A plain loop instead of gensub keeps this portable to BSD awk.
            text = ""
            prev = ""
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c ~ /[A-Z]/ && prev ~ /[a-z0-9]/) text = text " "
                text = text c
                prev = c
            }
            text = tolower(text)
            gsub(/_/, " ", text)
            # Drop the "file: +" prefix and comment leaders, then keep the
            # first and last two words for the cross-line check.
            body = substr(text, index(text, ": +") + 3)
            gsub(/[^a-z0-9-]+/, " ", body)
            w = split(body, words, " ")
            head = words[1] (w > 1 ? " " words[2] : "")
            if (text ~ ("(^|[^a-z0-9])(" markers ")([^a-z0-9]|$)")) {
                print
            } else if (tail != "" && phrases != "" && \
                (tail " " head) ~ ("(^| )(" phrases ")( |$)")) {
                print tail_line
                print
            }
            tail = (w > 1 ? words[w - 1] " " : "") words[w]
            tail_line = $0
        }
    ' || true)
    # Em dashes are only rejected in Rust comments: Markdown docs and skill
    # files use them widely, and Rust string literals may hold terminal text.
    dashes=$(printf '%s\n' "$added" | grep -E '^[^:]*\.rs: .*//.*—' || true)
    if [ -z "$slop" ] && [ -z "$dashes" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: refusing to commit AI slop containing '$slop_markers'
or an em dash in a Rust comment

$slop
$dashes
EOF
    failed=1
}

check_comment_rationale() {
    if [ -z "$code_files" ]; then
        return 0
    fi

    comment_lines=$(collect_added_comment_lines)
    if [ -z "$comment_lines" ]; then
        return 0
    fi

    instruction_refs=$(
        printf '%s\n' "$comment_lines" |
            grep -iE '(ADR[[:space:]]*[0-9]+|Phase[[:space:]]+[A-Z0-9]+|tasks?[ .:#§-]+[0-9]+|design[[:space:]]+(§[0-9]+|D[0-9]+)|CONTEXT\.md|docs/adr|tasks\.md|patch[[:space:]]+[0-9]{4}[-_][[:alnum:]_-]+|(^|[[:space:](/,:;-])[DP][0-9]+([./][0-9]+)*([^[:alnum:]_]|$)|[0-9]+\.[TA][0-9]+[a-z]?|[0-9]+(\.[0-9]+)?-D[0-9]+|(ADR|task|document|docs?|spec|design).{0,40}(require[sd]?|say[sd]?|mandate[sd]?)|(ADR|任务|文档|规范|设计).{0,40}(要求|规定|指出|说明))' || true
    )
    if [ -z "$instruction_refs" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: comments must explain technical rationale, not implementation instructions

Replace ADR/task/phase/document identifiers with the actual constraint, invariant,
tradeoff, compatibility concern, or failure mode. External protocol/API references
are allowed when the comment remains understandable without opening the reference.

$instruction_refs
EOF
    failed=1
}

check_no_xcode_signing_identity() {
    # A team ID, provisioning profile, or named certificate ties the Xcode
    # project to one developer account. Those live in the gitignored
    # mobile/ios/Config/Local.xcconfig or in environment variables. Picking a
    # team in Xcode's Signing & Capabilities tab writes it into project.pbxproj
    # instead, where it is easy to commit without noticing. Values that expand
    # a build setting, such as $(NMT_DEVELOPMENT_TEAM), stay allowed.
    # Deletions stay allowed, so a file committed by mistake can be removed.
    personal_files=$(git diff --cached --name-only --diff-filter=ACMR |
        grep -E '(^|/)(Local[.]xcconfig$|xcuserdata/)' || true)
    signing_lines=$(git diff --cached --diff-filter=ACMR -U0 -- '*.pbxproj' '*.xcconfig' |
        awk '
            /^\+\+\+ b\// { file = substr($0, 7); next }
            /^\+/ { print file ": " substr($0, 2) }
        ' |
        grep -E ': [[:space:]]*"?(DEVELOPMENT_TEAM|PROVISIONING_PROFILE(_SPECIFIER)?)(\[[^]]*\])?"?[[:space:]]*=[[:space:]]*"?[^"$;[:space:]]|: [[:space:]]*"?CODE_SIGN_IDENTITY(\[[^]]*\])?"?[[:space:]]*=.*:' ||
        true)
    if [ -z "$personal_files" ] && [ -z "$signing_lines" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: refusing to commit a personal Xcode signing identity

Set the team and bundle ID in mobile/ios/Config/Local.xcconfig (gitignored) or
the NMT_DEVELOPMENT_TEAM and NMT_BUNDLE_ID environment variables, and leave the
team unset in Xcode's Signing & Capabilities tab.

$personal_files
$signing_lines
EOF
    failed=1
}

check_readability() {
    readability_files=$(git diff --cached --name-only --no-renames \
        --diff-filter=ACM -- ':(glob)crates/**/*.rs' ':(glob)mobile/ios/**/*.swift')
    if [ -z "$readability_files" ]; then
        return 0
    fi

    if ! readability_output=$(cargo run --quiet --locked \
        --manifest-path tools/readability/Cargo.toml -- --staged 2>&1); then
        printf 'pre-commit: readability issues\n\n%s\n\n' "$readability_output" >&2
        failed=1
    fi
}

check_rustfmt_and_clippy() {
    rust_files=$(git diff --cached --name-only --diff-filter=ACMRD -- '*.rs')

    if [ -z "$rust_files" ]; then
        return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "pre-commit: jq is required to select changed workspace members" >&2
        failed=1
        return 0
    fi

    workspace_metadata=$(cargo metadata --no-deps --format-version 1 2>/dev/null) || {
        echo "pre-commit: failed to read Cargo workspace metadata" >&2
        failed=1
        return 0
    }

    package_classes=$(
        printf '%s\n' "$workspace_metadata" |
            jq -r --arg changed_files "$rust_files" '
                def normalize_path: gsub("\\\\"; "/");

                . as $workspace
                | ($workspace.workspace_root | normalize_path) as $root
                | ($changed_files
                    | split("\n")
                    | map(select(length > 0) | $root + "/" + normalize_path)
                  ) as $files
                | [
                    $workspace.packages[]
                    | select(.id as $id | $workspace.workspace_members | index($id))
                    | {
                        name,
                        directory: (.manifest_path
                            | normalize_path
                            | sub("/Cargo.toml$"; ""))
                      }
                  ] as $packages
                | ([
                    $files[] as $file
                    | [$packages[]
                        | select(.directory as $directory
                            | $file == $directory
                            or ($file | startswith($directory + "/")))]
                    | sort_by(.directory | length)
                    | last
                    | select(. != null)
                  ] | unique_by(.name)[]) as $package
                | [
                    (if ($package.directory | startswith($root + "/crates/"))
                     then "first_party"
                     else "other"
                     end),
                    $package.name
                  ]
                | @tsv
            '
    ) || {
        echo "pre-commit: failed to classify changed workspace members" >&2
        failed=1
        return 0
    }
    package_classes=$(printf '%s\n' "$package_classes" | tr -d '\r')

    rustfmt_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
    if [ -n "$rustfmt_files" ]; then
        set --
        while IFS= read -r file; do
            set -- "$@" "$file"
        done <<EOF
$rustfmt_files
EOF
        if ! rustfmt_output=$(rustfmt --edition 2024 --check \
            --config skip_children=true "$@" 2>&1); then
            printf 'pre-commit: rustfmt differences\n\n%s\n\n' "$rustfmt_output" >&2
            failed=1
        fi
    fi

    if [ -z "$package_classes" ]; then
        return 0
    fi

    first_party_packages=$(printf '%s\n' "$package_classes" |
        awk -F '\t' '$1 == "first_party" { print $2 }')
    other_packages=$(printf '%s\n' "$package_classes" |
        awk -F '\t' '$1 == "other" { print $2 }')

    # Clippy reports through check mode, so a run writes metadata-only artifacts
    # for the whole dependency graph where a build writes linked libraries. In a
    # shared target directory both sets stay on disk under different hashes and no
    # build reuses the check copies, so every crate accumulates a second artifact
    # set that only a manual delete removes. A nested directory keeps the check
    # artifacts disposable on their own, and an existing CARGO_TARGET_DIR is
    # extended rather than replaced so CI cache paths keep working.
    repo_root=$(git rev-parse --show-toplevel)
    clippy_target_dir="${CARGO_TARGET_DIR:-$repo_root/target}/pre-commit-check"

    if [ -n "$other_packages" ]; then
        set --
        for package in $other_packages; do
            set -- "$@" -p "$package"
        done

        run_clippy "$@"
    fi

    first_party_packages=$(printf '%s\n' "$first_party_packages" | tr -d '\r')
    if [ -z "$first_party_packages" ]; then
        return 0
    fi

    set --
    for package in $first_party_packages; do
        set -- "$@" -p "$package"
    done

    run_clippy "$@" -- -D clippy::absolute_paths -D clippy::complexity -D clippy::perf -D clippy::style
}

# Runs clippy and reports only its errors. A clippy run also prints every
# warning in the changed crates plus Cargo's workspace-level warnings, which
# would bury the few lines that block the commit. The short message format
# puts each diagnostic on one line, so the errors can be picked out; if a
# failure produced no recognizable error line, the full output is shown
# rather than hiding why the run failed.
run_clippy() {
    if clippy_output=$(CARGO_TARGET_DIR="$clippy_target_dir" cargo clippy \
        --all-targets --no-deps --quiet --message-format=short "$@" 2>&1); then
        return 0
    fi

    clippy_errors=$(printf '%s\n' "$clippy_output" | grep -E '(^|: )error(\[[^]]*\])?:' || true)
    printf 'pre-commit: clippy errors\n\n%s\n\n' "${clippy_errors:-$clippy_output}" >&2
    failed=1
}

branch=$(git symbolic-ref --quiet --short HEAD || true)
protected_paths='^([.]agents|[.]claude|[.]codex|openspec|spec|docs/adr|docs/agents|docs/superpowers)(/|$)'
# Vendored upstream headers and bindgen output carry whatever prose their source
# wrote, and editing those words out would make the checked-in copy disagree with
# the library it was generated from. The marker and comment-rationale checks read
# hand-written content only, so they skip these paths; the patches under
# third_party stay covered because we write those.
generated_paths='^third_party/[^/]+/(prebuilt/|src/bindings[.]rs$)'
code_file_pattern='(^|/)(Cargo[.](toml|lock)|build[.]rs)$|[.](rs|zig|c|cc|cpp|cxx|h|hh|hpp|hxx|m|mm|swift|py|sh|bash|zsh|ps1|js|jsx|ts|tsx|css|scss|html|wgsl|hlsl|metal)$'
staged_files=$(git diff --cached --name-only --diff-filter=ACMRD)
protected_files=$(printf '%s\n' "$staged_files" | grep -E "$protected_paths" || true)
code_files=$(collect_staged_code_files)
# Every check runs even after one fails, so a single attempt reports every
# problem instead of revealing them one commit attempt at a time.
failed=0

check_no_incomplete_openspec_changes
check_ai_docs_are_separate
check_third_party_dirs_are_separate
check_protected_paths_on_main
check_no_ai_slop_marker
check_comment_rationale
check_no_xcode_signing_identity
check_readability
check_rustfmt_and_clippy

if [ "$failed" -ne 0 ]; then
    echo "pre-commit: commit rejected; fix the issues above" >&2
    exit 1
fi
