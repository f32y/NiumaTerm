#!/bin/sh
set -eu

collect_staged_code_files() {
    printf '%s\n' "$staged_files" |
        awk -v protected="$protected_paths" -v code_path="$code_file_pattern" '
            $0 ~ protected { next }
            $0 ~ code_path { print }
        '
}

collect_added_comment_lines() {
    git diff --cached --diff-filter=ACMR -U0 |
        awk -v protected="$protected_paths" -v code_path="$code_file_pattern" '
            /^\+\+\+ b\// {
                file = substr($0, 7)
                code = file !~ protected && file ~ code_path
                next
            }
            code && /^\+[[:space:]]*(\/\/[/!]?|#|\/\*|\*|<!--)/ { print file ": " $0 }
        '
}

check_ai_docs_are_separate() {
    if [ -z "$protected_files" ] || [ -z "$code_files" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: AI docs must be committed separately

Protected paths:
$protected_files

Code files:
$code_files
EOF
    exit 1
}

check_no_incomplete_openspec_changes() {
    incomplete_spec_files=$(git diff --cached --name-only --diff-filter=ACMR |
        grep -E '^openspec/changes/' |
        grep -Ev '^openspec/changes/archive/' || true)
    if [ -z "$incomplete_spec_files" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: unfinished spec documents cannot be committed

$incomplete_spec_files
EOF
    exit 1
}

check_third_party_dirs_are_separate() {
    for isolated_path in third_party/gpui third_party/gpui-component; do
        isolated_files=$(printf '%s\n' "$staged_files" | grep -E "^$isolated_path/" || true)
        other_files=$(printf '%s\n' "$staged_files" | grep -Ev "^$isolated_path/" || true)
        if [ -z "$isolated_files" ] || [ -z "$other_files" ]; then
            continue
        fi

        cat >&2 <<EOF
pre-commit: $isolated_path must be committed separately

Files under $isolated_path:
$isolated_files

Other staged files:
$other_files
EOF
        exit 1
    done
}

check_protected_paths_on_main() {
    if [ "$branch" != "main" ] || [ -z "$protected_files" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: refusing protected-path commit on main

$protected_files
EOF
    exit 1
}

check_no_ai_slop_marker() {
    slop_markers='ponytail|seam|fact|parity|envelope|wire|contract'
    slop=$(git diff --cached --diff-filter=ACMR -U0 | grep -nE '^\+' | grep -Eiw "$slop_markers" || true)
    if [ -z "$slop" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: refusing to commit AI slop containing '$slop_markers'

$slop
EOF
    exit 1
}

check_comment_rationale() {
    if [ -z "$code_files" ]; then
        return 0
    fi

    comment_lines=$(collect_added_comment_lines)
    if [ -z "$comment_lines" ]; then
        return 0
    fi

    instruction_refs=$(
        printf '%s\n' "$comment_lines" |
            grep -iE '(ADR[[:space:]]*[0-9]+|Phase[[:space:]]+[A-Z0-9]+|tasks?[ .:#§-]+[0-9]+|design[[:space:]]+(§[0-9]+|D[0-9]+)|CONTEXT\.md|docs/adr|tasks\.md|patch[[:space:]]+[0-9]{4}[-_][[:alnum:]_-]+|(^|[[:space:](/,:;-])[DP][0-9]+([./][0-9]+)*([^[:alnum:]_]|$)|[0-9]+\.[TA][0-9]+[a-z]?|[0-9]+(\.[0-9]+)?-D[0-9]+|(ADR|task|document|docs?|spec|design).{0,40}(require[sd]?|say[sd]?|mandate[sd]?)|(ADR|任务|文档|规范|设计).{0,40}(要求|规定|指出|说明))' || true
    )
    if [ -z "$instruction_refs" ]; then
        return 0
    fi

    cat >&2 <<EOF
pre-commit: comments must explain technical rationale, not implementation instructions

Replace ADR/task/phase/document identifiers with the actual constraint, invariant,
tradeoff, compatibility concern, or failure mode. External protocol/API references
are allowed when the comment remains understandable without opening the reference.

$instruction_refs
EOF
    exit 1
}

check_rustfmt_and_clippy() {
    rust_files=$(git diff --cached --name-only --diff-filter=ACMRD -- '*.rs')

    if [ -z "$rust_files" ]; then
        echo "pre-commit: no staged Rust files; skipping rustfmt and clippy"
        return 0
    fi

    echo "pre-commit: staged Rust files detected"

    if ! command -v jq >/dev/null 2>&1; then
        echo "pre-commit: jq is required to select changed workspace members" >&2
        exit 1
    fi

    workspace_metadata=$(cargo metadata --no-deps --format-version 1) || {
        echo "pre-commit: failed to read Cargo workspace metadata" >&2
        exit 1
    }

    package_classes=$(
        printf '%s\n' "$workspace_metadata" |
            jq -r --arg changed_files "$rust_files" '
                def normalize_path: gsub("\\\\"; "/");

                . as $workspace
                | ($workspace.workspace_root | normalize_path) as $root
                | ($changed_files
                    | split("\n")
                    | map(select(length > 0) | $root + "/" + normalize_path)
                  ) as $files
                | [
                    $workspace.packages[]
                    | select(.id as $id | $workspace.workspace_members | index($id))
                    | {
                        name,
                        directory: (.manifest_path
                            | normalize_path
                            | sub("/Cargo.toml$"; ""))
                      }
                  ] as $packages
                | ([
                    $files[] as $file
                    | [$packages[]
                        | select(.directory as $directory
                            | $file == $directory
                            or ($file | startswith($directory + "/")))]
                    | sort_by(.directory | length)
                    | last
                    | select(. != null)
                  ] | unique_by(.name)[]) as $package
                | [
                    (if ($package.directory | startswith($root + "/crates/"))
                     then "first_party"
                     else "other"
                     end),
                    $package.name
                  ]
                | @tsv
            '
    ) || {
        echo "pre-commit: failed to classify changed workspace members" >&2
        exit 1
    }
    package_classes=$(printf '%s\n' "$package_classes" | tr -d '\r')

    rustfmt_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
    if [ -n "$rustfmt_files" ]; then
        echo "pre-commit: checking rustfmt on staged Rust files"
        set --
        while IFS= read -r file; do
            set -- "$@" "$file"
        done <<EOF
$rustfmt_files
EOF
        rustfmt --edition 2024 --check --config skip_children=true "$@"
    fi

    if [ -z "$package_classes" ]; then
        echo "pre-commit: staged Rust files are outside workspace members; skipping clippy"
        return 0
    fi

    first_party_packages=$(printf '%s\n' "$package_classes" |
        awk -F '\t' '$1 == "first_party" { print $2 }')
    other_packages=$(printf '%s\n' "$package_classes" |
        awk -F '\t' '$1 == "other" { print $2 }')

    if [ -n "$other_packages" ]; then
        set --
        for package in $other_packages; do
            set -- "$@" -p "$package"
        done

        echo "pre-commit: running clippy on changed non-first-party members"
        cargo clippy --all-targets --no-deps --quiet "$@"
    fi

    first_party_packages=$(printf '%s\n' "$first_party_packages" | tr -d '\r')
    if [ -z "$first_party_packages" ]; then
        echo "pre-commit: no changed first-party workspace members; skipping clippy::absolute_paths"
        return 0
    fi

    set --
    for package in $first_party_packages; do
        set -- "$@" -p "$package"
    done

    echo "pre-commit: running clippy::absolute_paths on changed first-party members"
    cargo clippy --all-targets --no-deps --quiet "$@" -- -D clippy::absolute_paths
}

branch=$(git symbolic-ref --quiet --short HEAD || true)
protected_paths='^([.]agents|[.]claude|[.]codex|[.]scratch|openspec|spec|docs/adr|docs/agents|docs/superpowers)(/|$)'
code_file_pattern='(^|/)(Cargo[.](toml|lock)|build[.]rs)$|[.](rs|zig|c|cc|cpp|cxx|h|hh|hpp|hxx|m|mm|swift|py|sh|bash|zsh|ps1|js|jsx|ts|tsx|css|scss|html|wgsl|hlsl|metal)$'
staged_files=$(git diff --cached --name-only --diff-filter=ACMRD)
protected_files=$(printf '%s\n' "$staged_files" | grep -E "$protected_paths" || true)
code_files=$(collect_staged_code_files)

check_no_incomplete_openspec_changes
check_ai_docs_are_separate
check_third_party_dirs_are_separate
check_protected_paths_on_main
check_no_ai_slop_marker
check_comment_rationale
check_rustfmt_and_clippy
