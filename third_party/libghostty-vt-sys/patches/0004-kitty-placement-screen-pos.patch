+/**
+ * Get the screen-absolute grid position of the current placement's pin.
+ *
+ * Unlike ghostty_kitty_graphics_placement_viewport_pos(), this reports the
+ * pin's row/column in the screen coordinate space (history + active area)
+ * and does NOT cull placements that have scrolled out of the viewport. This
+ * lets embedders intersect an off-screen placement with rows they are
+ * harvesting into scrollback history, where the viewport projection is
+ * unavailable. The image handle is not required.
+ *
+ * @param iterator The placement iterator positioned on a placement
+ * @param terminal The terminal handle
+ * @param[out] out_col On success, receives the screen-absolute column
+ * @param[out] out_row On success, receives the screen-absolute row
+ * @return GHOSTTY_SUCCESS on success, GHOSTTY_NO_VALUE for a virtual
+ *         (unicode placeholder) placement or when the pin's page has been
+ *         evicted, GHOSTTY_INVALID_VALUE if any handle is NULL or the
+ *         iterator is not positioned
+ *
+ * @ingroup kitty_graphics
+ */
+GHOSTTY_API GhosttyResult ghostty_kitty_graphics_placement_screen_pos(
+    GhosttyKittyGraphicsPlacementIterator iterator,
+    GhosttyTerminal terminal,
+    uint32_t* out_col,
+    uint32_t* out_row);
+
