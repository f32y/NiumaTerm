+//! C API for finished command blocks.
+//!
+//! Thread contract: every `ghostty_terminal_*` function in this file is a
+//! mutator or reads mutable state and must be called from the terminal's
+//! single writer thread (the same thread that calls vt_write). The
+//! refcounted read path — `ghostty_terminal_block_acquire`,
+//! `ghostty_block_ref_release`, and every `ghostty_block_ref_*` reader —
+//! may be called from any thread; an acquired reference pins an immutable
+//! snapshot (see BlockSet's thread model).
+
+const std = @import("std");
+const build_options = @import("terminal_options");
+const testing = std.testing;
+const lib = @import("../lib.zig");
+const CAllocator = lib.alloc.Allocator;
+const size = @import("../size.zig");
+const formatterpkg = @import("../formatter.zig");
+const Selection = @import("../Selection.zig");
+const grid_ref_c = @import("grid_ref.zig");
+const kitty_gfx_c = @import("kitty_graphics.zig");
+const terminal_c = @import("terminal.zig");
+const Result = @import("result.zig").Result;
+const BlockSet = terminal_c.ZigTerminal.BlockSet;
+
+const Terminal = terminal_c.Terminal;
+
+/// C: GhosttyBlockHandle
+pub const Handle = BlockSet.Handle;
+
+/// C: GhosttyBlockRef — an acquired read reference to a finished block.
+pub const BlockRef = ?*BlockSet.Block;
+
+/// Finish the current command block. On success fills out_handle with the
+/// handle of the frozen block. Returns NO_VALUE (and no block) when the
+/// active screen has no content, INVALID_VALUE when the alternate screen
+/// is active because blocks can only finish from the primary screen.
+pub fn finish_block(
+    terminal_: Terminal,
+    out_handle: ?*Handle,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const handle = t.finishBlock() catch |err| switch (err) {
+        error.NotPrimaryScreen => return .invalid_value,
+        error.OutOfMemory => return .out_of_memory,
+        else => return .out_of_memory,
+    } orelse return .no_value;
+    if (out_handle) |out| out.* = handle;
+    return .success;
+}
+
+/// Remove and destroy all finished blocks for a user-initiated clear-screen.
+pub fn clear_blocks(terminal_: Terminal) callconv(lib.calling_conv) void {
+    const t = (terminal_ orelse return).terminal;
+    t.blocks.clear(t.gpa());
+}
+
+/// Remove and destroy one block. Returns NO_VALUE for a stale handle.
+pub fn remove_block(
+    terminal_: Terminal,
+    handle: Handle,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    if (!t.blocks.remove(t.gpa(), handle)) return .no_value;
+    return .success;
+}
+
+pub fn block_count(terminal_: Terminal) callconv(lib.calling_conv) usize {
+    const t = (terminal_ orelse return 0).terminal;
+    return t.blocks.count();
+}
+
+/// The handle of the block at the given index, oldest first.
+pub fn block_at(
+    terminal_: Terminal,
+    index: usize,
+    out_handle: ?*Handle,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const handle = t.blocks.at(index) orelse return .no_value;
+    if (out_handle) |out| out.* = handle;
+    return .success;
+}
+
+/// The logical row count of a block: frozen rows with trailing blank rows
+/// (after the finish-time cursor) truncated. Readers must not read rows at
+/// or beyond this count. Returns NO_VALUE for a stale handle.
+pub fn block_row_count(
+    terminal_: Terminal,
+    handle: Handle,
+    out_rows: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const entry = t.blocks.get(handle) orelse return .no_value;
+    if (out_rows) |out| out.* = entry.rows;
+    return .success;
+}
+
+/// The column count the block was frozen at. Blocks keep their frozen
+/// width until reflowed; it can differ from the live terminal width.
+pub fn block_cols(
+    terminal_: Terminal,
+    handle: Handle,
+    out_cols: ?*u16,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const entry = t.blocks.get(handle) orelse return .no_value;
+    if (out_cols) |out| out.* = entry.screen.pages.cols;
+    return .success;
+}
+
+/// The memory retained by a block's page storage in bytes (page allocations
+/// only; Kitty image bytes are budgeted separately). The input for the
+/// finished-block byte budget. Returns NO_VALUE for a stale
+/// handle.
+pub fn block_bytes(
+    terminal_: Terminal,
+    handle: Handle,
+    out_bytes: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const entry = t.blocks.get(handle) orelse return .no_value;
+    if (out_bytes) |out| out.* = entry.screen.pages.page_size;
+    return .success;
+}
+
+/// Reflow one finished block to the given width for on-demand reflow;
+/// resize already reflows all blocks eagerly). Bumps the block's data
+/// generation; fetch the new one via block_at. Returns NO_VALUE for a
+/// stale handle. On allocation failure the block is destroyed rather than
+/// left in a garbage state, and OUT_OF_MEMORY is returned.
+pub fn reflow_block(
+    terminal_: Terminal,
+    handle: Handle,
+    cols: u16,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    if (cols == 0) return .invalid_value;
+    const ok = t.reflowBlock(handle, cols) catch {
+        _ = t.blocks.remove(t.gpa(), handle);
+        return .out_of_memory;
+    };
+    return if (ok) .success else .no_value;
+}
+
+/// Total page-storage bytes retained by all finished blocks (the value
+/// the block budget is enforced against).
+pub fn blocks_bytes(terminal_: Terminal) callconv(lib.calling_conv) usize {
+    const t = (terminal_ orelse return 0).terminal;
+    return t.blocks.totalBytes();
+}
+
+/// Resolve a row of a finished block to a grid ref at x=0. All existing
+/// grid-ref readers (cell, row, style, graphemes, hyperlink URI) work on
+/// the result. The ref is a snapshot: valid until the block is removed.
+/// Returns NO_VALUE for a stale handle, INVALID_VALUE for a row at or
+/// beyond the block's logical row count.
+pub fn block_grid_ref(
+    terminal_: Terminal,
+    handle: Handle,
+    row: usize,
+    out_ref: ?*grid_ref_c.CGridRef,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const entry = t.blocks.get(handle) orelse return .no_value;
+    if (row >= entry.rows) return .invalid_value;
+    const p = entry.screen.pages.pin(.{ .screen = .{
+        .x = 0,
+        .y = @intCast(row),
+    } }) orelse return .invalid_value;
+    if (out_ref) |out| out.* = grid_ref_c.CGridRef.fromPin(p);
+    return .success;
+}
+
+/// Take a read reference on a finished block. ANY THREAD. The reference
+/// pins an immutable snapshot readable without locks via the
+/// block_ref_* functions; it must be released with block_ref_release.
+/// Returns NO_VALUE for a stale handle or while the writer is reflowing
+/// the block (retry next frame).
+pub fn block_acquire(
+    terminal_: Terminal,
+    handle: Handle,
+    out_ref: ?*BlockRef,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const out = out_ref orelse return .invalid_value;
+    out.* = null;
+    const block = t.blocks.acquire(handle) orelse return .no_value;
+    out.* = block;
+    return .success;
+}
+
+/// Release a reference from block_acquire. ANY THREAD.
+pub fn block_ref_release(ref: BlockRef) callconv(lib.calling_conv) void {
+    (ref orelse return).release();
+}
+
+/// The (id, generation) of the acquired snapshot — the stable cache key
+/// for shaped/rendered rows. ANY THREAD (holding the ref).
+pub fn block_ref_handle(
+    ref: BlockRef,
+    out_handle: ?*Handle,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (out_handle) |out| out.* = block.handle();
+    return .success;
+}
+
+/// Logical row count of the snapshot. ANY THREAD (holding the ref).
+pub fn block_ref_row_count(
+    ref: BlockRef,
+    out_rows: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (out_rows) |out| out.* = block.rows;
+    return .success;
+}
+
+/// The column count of the snapshot. ANY THREAD (holding the ref).
+pub fn block_ref_cols(
+    ref: BlockRef,
+    out_cols: ?*u16,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (out_cols) |out| out.* = block.screen.pages.cols;
+    return .success;
+}
+
+/// Page-storage bytes of the snapshot. ANY THREAD (holding the ref).
+pub fn block_ref_bytes(
+    ref: BlockRef,
+    out_bytes: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (out_bytes) |out| out.* = block.screen.pages.page_size;
+    return .success;
+}
+
+/// Resolve a row of the snapshot to a grid ref at x=0; all grid-ref
+/// readers work on the result, valid while the reference is held.
+/// ANY THREAD (holding the ref).
+pub fn block_ref_grid_ref(
+    ref: BlockRef,
+    row: usize,
+    out_ref: ?*grid_ref_c.CGridRef,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (row >= block.rows) return .invalid_value;
+    const p = block.screen.pages.pin(.{ .screen = .{
+        .x = 0,
+        .y = @intCast(row),
+    } }) orelse return .invalid_value;
+    if (out_ref) |out| out.* = grid_ref_c.CGridRef.fromPin(p);
+    return .success;
+}
+
+/// The snapshot's Kitty graphics storage (frozen images + placements).
+/// All existing kitty_graphics_* readers (placement iterators, image
+/// pixel reads) work on the handle, valid while the reference is held.
+/// ANY THREAD (holding the ref). NO_VALUE if kitty graphics are disabled
+/// at build time.
+pub fn block_ref_kitty_graphics(
+    ref: BlockRef,
+    out_graphics: ?*kitty_gfx_c.KittyGraphics,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    if (out_graphics) |out| out.* = &block.screen.kitty_images;
+    return .success;
+}
+
+/// Block-relative grid position of the current placement's pin. The
+/// kitty_graphics variant of this
+/// resolves against the ACTIVE screen's page list; a frozen placement's
+/// pin lives in the block's own frozen pages, so it must resolve here.
+/// The iterator must come from this block's kitty graphics storage.
+/// Row/col are block-relative (same space as block_ref_grid_ref rows).
+/// NO_VALUE for virtual (unicode-placeholder) placements.
+/// ANY THREAD (holding the ref).
+pub fn block_ref_placement_pos(
+    ref: BlockRef,
+    iter_: kitty_gfx_c.PlacementIterator,
+    out_col: ?*u32,
+    out_row: ?*u32,
+) callconv(lib.calling_conv) Result {
+    const block = ref orelse return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const iter = iter_ orelse return .invalid_value;
+    const entry = iter.entry orelse return .invalid_value;
+
+    const pin = switch (entry.value_ptr.location) {
+        .pin => |pin| pin,
+        .virtual => return .no_value,
+    };
+
+    const pt = block.screen.pages.pointFromPin(.screen, pin.*) orelse return .no_value;
+    if (out_col) |out| out.* = @intCast(pt.screen.x);
+    if (out_row) |out| out.* = @intCast(pt.screen.y);
+    return .success;
+}
+
+/// C: GhosttyBlockFormatOptions — an inclusive cell range of the block.
+pub const BlockFormatOptions = extern struct {
+    size: usize = @sizeOf(BlockFormatOptions),
+    tl_row: usize,
+    tl_col: u16,
+    br_row: usize,
+    br_col: u16,
+    /// Rejoin soft-wrapped lines (no newline at a wrap point).
+    unwrap: bool,
+    /// Trim trailing blanks from each line.
+    trim: bool,
+};
+
+/// Export a cell range of the snapshot as plain UTF-8 text — the
+/// copy/deep-search floor. The buffer is allocated with
+/// the given allocator (default when null) and ownership transfers to
+/// the caller. ANY THREAD (holding the ref).
+pub fn block_ref_format_alloc(
+    ref: BlockRef,
+    alloc_: ?*const CAllocator,
+    opts: BlockFormatOptions,
+    out_ptr: *?[*]u8,
+    out_len: *usize,
+) callconv(lib.calling_conv) Result {
+    out_ptr.* = null;
+    out_len.* = 0;
+
+    const block = ref orelse return .invalid_value;
+    if (opts.size < @sizeOf(BlockFormatOptions)) return .invalid_value;
+    if (opts.tl_row > opts.br_row) return .invalid_value;
+    if (opts.br_row >= block.rows) return .invalid_value;
+
+    const pages = &block.screen.pages;
+    const tl = pages.pin(.{ .screen = .{
+        .x = @min(opts.tl_col, pages.cols - 1),
+        .y = @intCast(opts.tl_row),
+    } }) orelse return .invalid_value;
+    const br = pages.pin(.{ .screen = .{
+        .x = @min(opts.br_col, pages.cols - 1),
+        .y = @intCast(opts.br_row),
+    } }) orelse return .invalid_value;
+
+    var formatter: formatterpkg.ScreenFormatter = .init(block.screen, .{
+        .emit = .plain,
+        .unwrap = opts.unwrap,
+        .trim = opts.trim,
+    });
+    formatter.content = .{ .selection = Selection.init(tl, br, false) };
+
+    const alloc = lib.alloc.default(alloc_);
+    var aw: std.Io.Writer.Allocating = .init(alloc);
+    defer aw.deinit();
+    formatter.format(&aw.writer) catch return .out_of_memory;
+
+    const buf = aw.toOwnedSlice() catch return .out_of_memory;
+    out_ptr.* = buf.ptr;
+    out_len.* = buf.len;
+    return .success;
+}
+
+test "block C API lifecycle and readback" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &t,
+        .{ .cols = 10, .rows = 5, .max_scrollback = 0 },
+    ));
+    defer terminal_c.free(t);
+
+    // Empty screen: no block.
+    var handle: Handle = undefined;
+    try testing.expectEqual(Result.no_value, finish_block(t, &handle));
+
+    const input = "hello\r\nworld";
+    terminal_c.vt_write(t, input.ptr, input.len);
+    try testing.expectEqual(Result.success, finish_block(t, &handle));
+    try testing.expectEqual(@as(usize, 1), block_count(t));
+
+    var at_handle: Handle = undefined;
+    try testing.expectEqual(Result.success, block_at(t, 0, &at_handle));
+    try testing.expectEqual(handle, at_handle);
+    try testing.expectEqual(Result.no_value, block_at(t, 1, &at_handle));
+
+    var rows: usize = 0;
+    try testing.expectEqual(Result.success, block_row_count(t, handle, &rows));
+    try testing.expectEqual(@as(usize, 2), rows);
+
+    var cols: u16 = 0;
+    try testing.expectEqual(Result.success, block_cols(t, handle, &cols));
+    try testing.expectEqual(@as(u16, 10), cols);
+
+    // Read back "world" from row 1 through the grid-ref readers.
+    var ref: grid_ref_c.CGridRef = .{};
+    try testing.expectEqual(Result.success, block_grid_ref(t, handle, 1, &ref));
+    var text: [5]u8 = undefined;
+    for (0..5) |x| {
+        ref.x = @intCast(x);
+        var cell: @import("cell.zig").CCell = undefined;
+        try testing.expectEqual(Result.success, grid_ref_c.grid_ref_cell(&ref, &cell));
+        const zig_cell: @import("../page.zig").Cell = @bitCast(cell);
+        text[x] = @intCast(zig_cell.codepoint());
+    }
+    try testing.expectEqualStrings("world", &text);
+
+    // Rows beyond the logical count are rejected.
+    try testing.expectEqual(Result.invalid_value, block_grid_ref(t, handle, 2, &ref));
+
+    // Stale handle after removal.
+    try testing.expectEqual(Result.success, remove_block(t, handle));
+    try testing.expectEqual(Result.no_value, remove_block(t, handle));
+    try testing.expectEqual(Result.no_value, block_row_count(t, handle, &rows));
+    try testing.expectEqual(@as(usize, 0), block_count(t));
+
+    // clear_blocks drops everything.
+    const again = "again";
+    terminal_c.vt_write(t, again.ptr, again.len);
+    try testing.expectEqual(Result.success, finish_block(t, &handle));
+    clear_blocks(t);
+    try testing.expectEqual(@as(usize, 0), block_count(t));
+}
+
+test "block ref acquire, readback, format, and deferred destroy" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &t,
+        .{ .cols = 10, .rows = 5, .max_scrollback = 0 },
+    ));
+    defer terminal_c.free(t);
+
+    var handle: Handle = undefined;
+    const input = "hello\r\nworld";
+    terminal_c.vt_write(t, input.ptr, input.len);
+    try testing.expectEqual(Result.success, finish_block(t, &handle));
+
+    var ref: BlockRef = null;
+    try testing.expectEqual(Result.success, block_acquire(t, handle, &ref));
+    defer block_ref_release(ref);
+
+    var got: Handle = undefined;
+    try testing.expectEqual(Result.success, block_ref_handle(ref, &got));
+    try testing.expectEqual(handle, got);
+
+    var rows: usize = 0;
+    try testing.expectEqual(Result.success, block_ref_row_count(ref, &rows));
+    try testing.expectEqual(@as(usize, 2), rows);
+    var cols: u16 = 0;
+    try testing.expectEqual(Result.success, block_ref_cols(ref, &cols));
+    try testing.expectEqual(@as(u16, 10), cols);
+    var bytes: usize = 0;
+    try testing.expectEqual(Result.success, block_ref_bytes(ref, &bytes));
+    try testing.expect(bytes > 0);
+
+    // Cell readback through the ref-resolved grid ref.
+    var gref: grid_ref_c.CGridRef = .{};
+    try testing.expectEqual(Result.success, block_ref_grid_ref(ref, 1, &gref));
+    var cell: @import("cell.zig").CCell = undefined;
+    try testing.expectEqual(Result.success, grid_ref_c.grid_ref_cell(&gref, &cell));
+    const zig_cell: @import("../page.zig").Cell = @bitCast(cell);
+    try testing.expectEqual(@as(u21, 'w'), zig_cell.codepoint());
+    try testing.expectEqual(Result.invalid_value, block_ref_grid_ref(ref, 2, &gref));
+
+    // Full-range plain text export.
+    var out_ptr: ?[*]u8 = null;
+    var out_len: usize = 0;
+    try testing.expectEqual(Result.success, block_ref_format_alloc(
+        ref,
+        &lib.alloc.test_allocator,
+        .{ .tl_row = 0, .tl_col = 0, .br_row = 1, .br_col = 9, .unwrap = true, .trim = true },
+        &out_ptr,
+        &out_len,
+    ));
+    const text = out_ptr.?[0..out_len];
+    defer lib.alloc.default(&lib.alloc.test_allocator).free(text);
+    try testing.expectEqualStrings(
+        "hello\nworld",
+        std.mem.trimEnd(u8, text, "\n"),
+    );
+
+    // Remove while the ref is held: handle goes stale immediately, the
+    // snapshot stays readable until release (defer above).
+    try testing.expectEqual(Result.success, remove_block(t, handle));
+    try testing.expectEqual(@as(usize, 0), block_count(t));
+    var ref2: BlockRef = null;
+    try testing.expectEqual(Result.no_value, block_acquire(t, handle, &ref2));
+    try testing.expectEqual(Result.success, block_ref_row_count(ref, &rows));
+    try testing.expectEqual(@as(usize, 2), rows);
+}
+
+test "block budget option evicts immediately and blocks_bytes reports totals" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &t,
+        .{ .cols = 10, .rows = 5, .max_scrollback = 0 },
+    ));
+    defer terminal_c.free(t);
+
+    var handle: Handle = undefined;
+    for (0..3) |_| {
+        const input = "hello";
+        terminal_c.vt_write(t, input.ptr, input.len);
+        try testing.expectEqual(Result.success, finish_block(t, &handle));
+    }
+    try testing.expectEqual(@as(usize, 3), block_count(t));
+    try testing.expect(blocks_bytes(t) > 0);
+
+    // Shrinking the budget evicts oldest-first immediately, keeping the
+    // newest block.
+    const tiny: usize = 1;
+    try testing.expectEqual(Result.success, terminal_c.set(
+        t,
+        .block_budget_bytes,
+        &tiny,
+    ));
+    try testing.expectEqual(@as(usize, 1), block_count(t));
+    var kept: Handle = undefined;
+    try testing.expectEqual(Result.success, block_at(t, 0, &kept));
+    try testing.expectEqual(handle.id, kept.id);
+}
+
+test "block reset scoping: stream RIS keeps blocks, API reset clears them" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &t,
+        .{ .cols = 10, .rows = 5, .max_scrollback = 0 },
+    ));
+    defer terminal_c.free(t);
+
+    var handle: Handle = undefined;
+    const input = "hello";
+    terminal_c.vt_write(t, input.ptr, input.len);
+    try testing.expectEqual(Result.success, finish_block(t, &handle));
+
+    // Program-initiated RIS in the VT stream resets only the active screen.
+    const ris = "\x1bc";
+    terminal_c.vt_write(t, ris.ptr, ris.len);
+    try testing.expectEqual(@as(usize, 1), block_count(t));
+
+    // API-level full reset: blocks destroyed too.
+    terminal_c.reset(t);
+    try testing.expectEqual(@as(usize, 0), block_count(t));
+    var rows: usize = 0;
+    try testing.expectEqual(Result.no_value, block_row_count(t, handle, &rows));
+}
+
+test "block_ref_placement_pos resolves against the frozen pages" {
+    if (comptime !build_options.kitty_graphics) return error.SkipZigTest;
+
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &t,
+        .{ .cols = 10, .rows = 5, .max_scrollback = 10_000 },
+    ));
+    defer terminal_c.free(t);
+
+    // Two rows of text, then a 1x1 kitty image placed at row 2.
+    const pre = "a\r\nb\r\n";
+    terminal_c.vt_write(t, pre.ptr, pre.len);
+    const img = "\x1b_Ga=T,f=32,s=1,v=1,i=7;/wAA/w==\x1b\\";
+    terminal_c.vt_write(t, img.ptr, img.len);
+
+    var handle: Handle = undefined;
+    try testing.expectEqual(Result.success, finish_block(t, &handle));
+
+    var ref: BlockRef = null;
+    try testing.expectEqual(Result.success, block_acquire(t, handle, &ref));
+    defer block_ref_release(ref);
+
+    var graphics: kitty_gfx_c.KittyGraphics = undefined;
+    try testing.expectEqual(Result.success, block_ref_kitty_graphics(ref, &graphics));
+
+    var iter: kitty_gfx_c.PlacementIterator = null;
+    try testing.expectEqual(Result.success, kitty_gfx_c.placement_iterator_new(
+        &lib.alloc.test_allocator,
+        &iter,
+    ));
+    defer kitty_gfx_c.placement_iterator_free(iter);
+    try testing.expectEqual(Result.success, kitty_gfx_c.get(
+        graphics,
+        .placement_iterator,
+        @ptrCast(&iter),
+    ));
+    try testing.expect(kitty_gfx_c.placement_iterator_next(iter));
+
+    var col: u32 = 99;
+    var row: u32 = 99;
+    try testing.expectEqual(Result.success, block_ref_placement_pos(ref, iter, &col, &row));
+    try testing.expectEqual(@as(u32, 0), col);
+    try testing.expectEqual(@as(u32, 2), row);
+
+    // The active-screen resolver must NOT find this frozen pin — that is
+    // exactly why the block-relative variant exists.
+    try testing.expectEqual(Result.no_value, kitty_gfx_c.placement_screen_pos(iter, t, &col, &row));
+}
