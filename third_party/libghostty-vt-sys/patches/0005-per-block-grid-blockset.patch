+/// Replace the screen stored at the given key with a new screen,
+/// returning the old screen. Ownership of the old screen transfers to
+/// the caller; ownership of the new screen transfers to the set. Bumps
+/// the key generation so stale external handles (e.g. tracked grid refs)
+/// detach, the same contract as remove+reinit. Requires the key to be
+/// initialized. Used by Terminal.finishBlock to move the primary screen
+/// into the block set.
+pub fn replace(self: *ScreenSet, key: Key, screen: *Screen) *Screen {
+    const old = self.all.get(key).?;
+    self.all.put(key, screen);
+    self.generations.put(key, self.generation(key) +% 1);
+    if (self.active_key == key) self.active = screen;
+    return old;
+}
