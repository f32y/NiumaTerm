+    // ownership: the old screen's PageList — pages, pins, styles, image
+    // storage, placements — transfers wholesale, which is what makes
+    // finish O(1).
+    const handle = try self.blocks.append(alloc, .{
+        .screen = old,
+        .rows = block_rows,
+        .trailing_blanks = block_rows - content_rows,
+    });
+    const replaced = self.screens.replace(.primary, new_screen);
+    assert(replaced == old);
+
+    // Enforce the finished-block byte budget: oldest blocks (and their
+    // images) are destroyed until we fit. The block we just finished is
+    // never evicted (newest survives).
+    _ = self.blocks.enforceBudget(alloc);
+
+    // Everything visible changed.
+    self.flags.dirty.clear = true;
+
+    return handle;
+}
+
+/// Reflow one finished block to the given width. A rebuild of the block's
+/// data: bumps the data generation (readers key caches on
+/// (id, generation)) and recomputes the logical row count, preserving
+/// intentional trailing blank rows. Blocks reflow independently, so a
+/// block boundary is a hard wrap boundary. Returns false for a stale
+/// handle; no-op (true) when the block is already at the width.
+///
+/// On error the block's screen may be in a garbage state (same contract
+/// as Screen.resize); callers should remove the block.
+pub fn reflowBlock(
+    self: *Terminal,
+    handle: BlockSet.Handle,
+    cols: size.CellCountInt,
+) !bool {
+    const block = self.blocks.getPtr(handle) orelse return false;
+    if (block.screen.pages.cols == cols) return true;
+
+    // Drain readers before mutating: acquires are refused and the write
+    // waits for outstanding references, so no reader ever observes a
+    // mid-reflow state (BlockSet thread model).
+    self.blocks.beginWrite(block);
+    defer self.blocks.endWrite(block);
+
+    try block.screen.resize(.{
+        .cols = cols,
+        .rows = block.screen.pages.rows,
+        .reflow = true,
+    });
+    block.generation +%= 1;
+    block.rows = block.screen.pages.contentRows() + block.trailing_blanks;
+    return true;
+}
