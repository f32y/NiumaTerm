+test "Terminal: concurrent block reads survive finish, eviction, and reflow" {
+    if (comptime builtin.single_threaded) return error.SkipZigTest;
+
+    // Reader threads release references, which can destroy blocks
+    // (deallocate) off the writer thread; the allocator must be
+    // thread-safe.
+    var tsa: std.heap.ThreadSafeAllocator = .{
+        .child_allocator = testing.allocator,
+    };
+    const alloc = tsa.allocator();
+
+    // A small budget keeps eviction churning while the writer finishes
+    // blocks, so readers constantly race detach-and-deferred-destroy.
+    var t = try init(alloc, .{
+        .cols = 20,
+        .rows = 5,
+        .block_budget_bytes = 4 * 1024 * 1024,
+    });
+    defer t.deinit(alloc);
+
+    const Shared = struct {
+        blocks: *BlockSet,
+        latest_id: std.atomic.Value(u64) = .init(0),
+        done: std.atomic.Value(bool) = .init(false),
+
+        fn reader(shared: *@This()) void {
+            while (!shared.done.load(.acquire)) {
+                const id = shared.latest_id.load(.acquire);
+                if (id == 0) continue;
+                // Generation is irrelevant for lookup (id-only).
+                const block = shared.blocks.acquire(.{
+                    .id = id,
+                    .generation = 0,
+                }) orelse continue;
+                defer block.release();
+
+                // Read the pinned snapshot: logical rows, then walk a few
+                // cells the way the render path would.
+                var checked: usize = 0;
+                var row: usize = 0;
+                while (row < block.rows and row < 4) : (row += 1) {
+                    const pin = block.screen.pages.pin(.{ .screen = .{
+                        .x = 0,
+                        .y = @intCast(row),
+                    } }) orelse break;
+                    const rac = pin.rowAndCell();
+                    checked += @intFromBool(rac.cell.codepoint() != 0);
+                }
+                std.mem.doNotOptimizeAway(checked);
+            }
+        }
+    };
+
+    var shared: Shared = .{ .blocks = &t.blocks };
+    var threads: [2]std.Thread = undefined;
+    for (&threads) |*th| th.* = try std.Thread.spawn(.{}, Shared.reader, .{&shared});
+    defer {
+        shared.done.store(true, .release);
+        for (threads) |th| th.join();
+    }
+
+    // Writer: finish blocks under budget churn, punctuated by resizes
+    // (block reflow drains readers) and explicit removals.
+    var cols: size.CellCountInt = 20;
+    var i: usize = 0;
+    while (i < 300) : (i += 1) {
+        try t.printString("the quick brown fox jumps over the lazy dog");
+        const handle = (try t.finishBlock()).?;
+        shared.latest_id.store(handle.id, .release);
+
+        if (i % 25 == 24) {
+            cols = if (cols == 20) 24 else 20;
+            try t.resize(alloc, cols, 5);
+        }
+        if (i % 40 == 39) {
+            // Remove the latest block while readers may hold it.
+            shared.latest_id.store(0, .release);
+            _ = t.blocks.remove(alloc, handle);
+        }
+    }
+    // deinit (deferred) asserts every reference was released; the testing
+    // allocator flags any leaked block.
+}
