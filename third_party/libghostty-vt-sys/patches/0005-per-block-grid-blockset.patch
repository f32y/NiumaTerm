diff --git a/src/terminal/BlockSet.zig b/src/terminal/BlockSet.zig
new file mode 100644
index 000000000..1c70b1d34
--- /dev/null
+++ b/src/terminal/BlockSet.zig
@@ -0,0 +1,395 @@
+/// A BlockSet holds the finished command blocks of a terminal. Each block
+/// is a frozen Screen (PageList + per-screen Kitty image storage) whose
+/// ownership was moved out of the ScreenSet by Terminal.finishBlock. A
+/// finished block never receives VT writes again.
+///
+/// Blocks are ordered oldest-first (insertion order == monotonic id order),
+/// which is also the eviction order. Ids are never reused; a stale handle
+/// (removed or evicted block) never resolves to another block.
+///
+/// ## Thread model
+///
+/// Single writer, refcounted readers:
+///
+/// - All mutation (append, remove, clear, eviction, reflow) happens on the
+///   terminal's single writer thread (the thread that feeds vt_write).
+/// - Any thread may `acquire` a block, read through the returned `*Block`
+///   without further locking, and `release` it. While at least one
+///   reference is held the block's data is immutable and cannot be freed:
+///   remove/evict/clear detach the block from the table immediately (its
+///   handle goes stale) but destruction is deferred until the last
+///   reference is released.
+/// - Reflow mutates in place, but only after draining readers: the writer
+///   marks the block `writing` (new acquires are refused, returning null —
+///   callers retry next frame) and waits until the reference count reaches
+///   zero. Readers therefore never observe a mid-reflow state, which is
+///   observably equivalent to rebuild-and-swap for every reader.
+///   In-place reflow is what lets frozen Kitty placements re-pin through
+///   the existing tracked-pin machinery instead of requiring an
+///   ImageStorage deep clone. If lazy reflow ever needs reads to
+///   proceed *during* a reflow, upgrade this to a true rebuild+swap.
+/// - References are expected to be short-lived (held for one read pass,
+///   e.g. a frame). The writer's reflow drain blocks for as long as the
+///   longest outstanding reference.
+/// - All references must be released before the terminal is deinitialized.
+const BlockSet = @This();
+
+const std = @import("std");
+const assert = @import("../quirks.zig").inlineAssert;
+const testing = std.testing;
+const Allocator = std.mem.Allocator;
+const Screen = @import("Screen.zig");
+
+/// Stable identifier for a finished block. Lookup is by `id` alone (ids
+/// are never reused, so an id can never resolve to another block).
+/// `generation` is the data version: it starts at 0 and is bumped whenever
+/// the block's content is rebuilt (reflow), so (id, generation) is a
+/// stable cache key for shaped/rendered rows. Fetch the current generation
+/// with `at`.
+pub const Handle = extern struct {
+    id: u64,
+    generation: u64,
+};
+
+/// One finished block. Heap-allocated and shared with readers: the
+/// pointer returned by `acquire` stays valid until the matching
+/// `release`, even if the block is removed or evicted in between.
+///
+/// Field access rules:
+/// - `screen`, `rows`, `trailing_blanks`, `generation`: written by the
+///   writer thread only, and only while no reader holds a reference
+///   (append before publication, reflow after draining). Readers holding
+///   a reference may read them without locking.
+/// - `refs`, `writing`, `detached`: guarded by the owning set's mutex.
+pub const Block = struct {
+    alloc: Allocator,
+    owner: *BlockSet,
+    id: u64,
+
+    /// The frozen screen.
+    screen: *Screen,
+
+    /// Logical row count of the block: the frozen screen's rows with
+    /// trailing blank rows truncated at finish time (Terminal.finishBlock).
+    /// Readers must not read rows at or beyond this count. Recomputed on
+    /// reflow as contentRows() + trailing_blanks.
+    rows: usize,
+
+    /// How many of `rows` are intentional trailing blank rows (the
+    /// command's trailing newlines, before the finish-time cursor). Blank
+    /// rows carry no text, so contentRows() can't see them after a reflow;
+    /// this count re-extends the logical row count past the last text row.
+    trailing_blanks: usize = 0,
+
+    /// Data generation, bumped on reflow (see Handle.generation).
+    generation: u64 = 0,
+
+    /// Outstanding reader references. Guarded by owner.mutex.
+    refs: u32 = 0,
+
+    /// The writer is reflowing this block; acquire refuses. Guarded by
+    /// owner.mutex.
+    writing: bool = false,
+
+    /// Removed/evicted from the table; destroy when refs hits zero.
+    /// Guarded by owner.mutex.
+    detached: bool = false,
+
+    pub fn handle(self: *const Block) Handle {
+        return .{ .id = self.id, .generation = self.generation };
+    }
+
+    fn destroy(self: *Block) void {
+        self.screen.deinit();
+        self.alloc.destroy(self.screen);
+        self.alloc.destroy(self);
+    }
+
+    /// Release a reference obtained with `acquire`. Any thread. Frees the
+    /// block if it was detached and this was the last reference.
+    pub fn release(self: *Block) void {
+        const set = self.owner;
+        set.mutex.lock();
+        assert(self.refs > 0);
+        self.refs -= 1;
+        const free = self.detached and self.refs == 0;
+        if (self.refs == 0) set.drained.broadcast();
+        set.mutex.unlock();
+        if (free) self.destroy();
+    }
+};
+
+/// Ordered oldest-first: ArrayHashMap preserves insertion order and ids
+/// are monotonic. Map reads on the writer thread need no lock (the writer
+/// is the only mutator); map mutation and reader `acquire` take `mutex`.
+entries: std.AutoArrayHashMapUnmanaged(u64, *Block) = .empty,
+next_id: u64 = 1,
+
+/// Guards map mutation vs. reader acquire, and every Block's
+/// refs/writing/detached fields.
+mutex: std.Thread.Mutex = .{},
+
+/// Signaled whenever a block's refcount drops to zero; the reflow drain
+/// waits on it.
+drained: std.Thread.Condition = .{},
+
+/// Byte budget for the page storage of all finished blocks combined.
+/// Oldest blocks are evicted (images released with them) when the total
+/// exceeds this. Zero means unlimited. The newest block is never evicted,
+/// so a single oversized block survives.
+budget_bytes: usize = default_budget_bytes,
+
+/// Default budget: ~200k rows at 80 cols, from the measured
+/// ~695 KB per 1k rows of frozen page storage.
+pub const default_budget_bytes: usize = 139 * 1000 * 1000;
+
+/// Writer thread, terminal teardown. All reader references must have been
+/// released (asserted).
+pub fn deinit(self: *BlockSet, alloc: Allocator) void {
+    for (self.entries.values()) |block| {
+        assert(block.refs == 0);
+        block.destroy();
+    }
+    self.entries.deinit(alloc);
+}
+
+/// Writer thread. Take ownership of a finished screen, returning its
+/// handle.
+pub fn append(
+    self: *BlockSet,
+    alloc: Allocator,
+    opts: struct {
+        screen: *Screen,
+        rows: usize,
+        trailing_blanks: usize = 0,
+    },
+) Allocator.Error!Handle {
+    const block = try alloc.create(Block);
+    errdefer alloc.destroy(block);
+    block.* = .{
+        .alloc = alloc,
+        .owner = self,
+        .id = self.next_id,
+        .screen = opts.screen,
+        .rows = opts.rows,
+        .trailing_blanks = opts.trailing_blanks,
+    };
+
+    self.mutex.lock();
+    defer self.mutex.unlock();
+    try self.entries.putNoClobber(alloc, block.id, block);
+    self.next_id += 1;
+    return block.handle();
+}
+
+/// Writer thread. Resolve a handle, or null if the handle is stale
+/// (removed/evicted block). Lookup is by id; the handle's generation is
+/// a data-version tag for cache keying, not part of identity.
+pub fn get(self: *const BlockSet, handle: Handle) ?*const Block {
+    return self.entries.get(handle.id);
+}
+
+/// Mutable variant of `get` for the writer's reflow path.
+pub fn getPtr(self: *BlockSet, handle: Handle) ?*Block {
+    return self.entries.get(handle.id);
+}
+
+/// Any thread. Take a read reference on a block. Returns null for a stale
+/// handle or while the writer is reflowing the block (retry next frame).
+/// The returned pointer and everything reachable from it (screen, pages,
+/// image storage) stays valid and immutable until `Block.release`.
+pub fn acquire(self: *BlockSet, handle: Handle) ?*Block {
+    self.mutex.lock();
+    defer self.mutex.unlock();
+    const block = self.entries.get(handle.id) orelse return null;
+    if (block.writing) return null;
+    block.refs += 1;
+    return block;
+}
+
+/// Writer thread. Mark a block as being rewritten and wait for all reader
+/// references to drain. New acquires are refused until `endWrite`.
+pub fn beginWrite(self: *BlockSet, block: *Block) void {
+    self.mutex.lock();
+    defer self.mutex.unlock();
+    assert(!block.writing);
+    block.writing = true;
+    while (block.refs > 0) self.drained.wait(&self.mutex);
+}
+
+/// Writer thread. Re-open a block for readers after `beginWrite`.
+pub fn endWrite(self: *BlockSet, block: *Block) void {
+    self.mutex.lock();
+    defer self.mutex.unlock();
+    assert(block.writing);
+    block.writing = false;
+}
+
+/// Writer thread. Remove a block; its handle goes stale immediately.
+/// Destruction is deferred until the last reader reference is released.
+/// Returns false if the handle is stale.
+pub fn remove(self: *BlockSet, alloc: Allocator, handle: Handle) bool {
+    _ = alloc;
+    self.mutex.lock();
+    // O(count) to preserve oldest-first order; eviction removes index 0.
+    const block = self.entries.get(handle.id) orelse {
+        self.mutex.unlock();
+        return false;
+    };
+    const removed = self.entries.orderedRemove(handle.id);
+    assert(removed);
+    block.detached = true;
+    const free = block.refs == 0;
+    self.mutex.unlock();
+    if (free) block.destroy();
+    return true;
+}
+
+/// Writer thread. Remove all blocks (destruction deferred per block while
+/// references are held).
+pub fn clear(self: *BlockSet, alloc: Allocator) void {
+    _ = alloc;
+    self.mutex.lock();
+    defer self.mutex.unlock();
+    // destroy() takes no locks, so freeing under the mutex is safe; clear
+    // is a rare user action, the extra hold time doesn't matter.
+    for (self.entries.values()) |block| {
+        block.detached = true;
+        if (block.refs == 0) block.destroy();
+    }
+    self.entries.clearRetainingCapacity();
+}
+
+/// Writer thread.
+pub fn count(self: *const BlockSet) usize {
+    return self.entries.count();
+}
+
+/// Writer thread. Total page-storage bytes retained by all finished
+/// blocks. O(count); per-block bytes change on reflow, so this is not
+/// cached.
+pub fn totalBytes(self: *const BlockSet) usize {
+    var total: usize = 0;
+    for (self.entries.values()) |block| total += block.screen.pages.page_size;
+    return total;
+}
+
+/// Writer thread. Evict oldest blocks until the total is within
+/// budget_bytes (or one block remains). Returns the number of blocks
+/// evicted. Destruction of still-referenced blocks is deferred (their
+/// bytes are considered released for budget purposes: the data is
+/// unreachable and will be freed as soon as the reader finishes).
+pub fn enforceBudget(self: *BlockSet, alloc: Allocator) usize {
+    if (self.budget_bytes == 0) return 0;
+    var evicted: usize = 0;
+    var total = self.totalBytes();
+    while (total > self.budget_bytes and self.entries.count() > 1) {
+        const oldest = self.at(0).?;
+        total -= self.entries.values()[0].screen.pages.page_size;
+        const removed = self.remove(alloc, oldest);
+        assert(removed);
+        evicted += 1;
+    }
+    return evicted;
+}
+
+/// Writer thread. The handle of the block at the given index, oldest
+/// first.
+pub fn at(self: *const BlockSet, index: usize) ?Handle {
+    if (index >= self.entries.count()) return null;
+    return self.entries.values()[index].handle();
+}
+
+test "BlockSet lifecycle and stale handles" {
+    const alloc = testing.allocator;
+    var set: BlockSet = .{};
+    defer set.deinit(alloc);
+
+    const s1 = try alloc.create(Screen);
+    s1.* = try .init(alloc, .default);
+    const h1 = try set.append(alloc, .{ .screen = s1, .rows = 3 });
+
+    const s2 = try alloc.create(Screen);
+    s2.* = try .init(alloc, .default);
+    const h2 = try set.append(alloc, .{ .screen = s2, .rows = 5 });
+
+    try testing.expectEqual(@as(usize, 2), set.count());
+    try testing.expect(h1.id != h2.id);
+    try testing.expectEqual(h1, set.at(0).?);
+    try testing.expectEqual(h2, set.at(1).?);
+    try testing.expectEqual(@as(usize, 3), set.get(h1).?.rows);
+
+    // Remove keeps order and invalidates only the removed handle.
+    try testing.expect(set.remove(alloc, h1));
+    try testing.expect(!set.remove(alloc, h1));
+    try testing.expect(set.get(h1) == null);
+    try testing.expectEqual(h2, set.at(0).?);
+
+    // Lookup is by id: a different generation still resolves (generation
+    // is a data-version tag for cache keys, bumped on reflow).
+    try testing.expect(set.get(.{ .id = h2.id, .generation = h2.generation + 1 }) != null);
+
+    // Ids are never reused after removal.
+    const s3 = try alloc.create(Screen);
+    s3.* = try .init(alloc, .default);
+    const h3 = try set.append(alloc, .{ .screen = s3, .rows = 1 });
+    try testing.expect(h3.id != h1.id);
+    try testing.expect(set.get(h1) == null);
+
+    set.clear(alloc);
+    try testing.expectEqual(@as(usize, 0), set.count());
+    try testing.expect(set.get(h3) == null);
+}
+
+test "BlockSet acquire defers destruction past remove and clear" {
+    const alloc = testing.allocator;
+    var set: BlockSet = .{};
+    defer set.deinit(alloc);
+
+    const s1 = try alloc.create(Screen);
+    s1.* = try .init(alloc, .default);
+    const h1 = try set.append(alloc, .{ .screen = s1, .rows = 1 });
+
+    const ref = set.acquire(h1).?;
+    const ref2 = set.acquire(h1).?;
+    try testing.expect(ref == ref2);
+
+    // Remove: handle stale immediately, data still alive behind the refs.
+    try testing.expect(set.remove(alloc, h1));
+    try testing.expect(set.get(h1) == null);
+    try testing.expect(set.acquire(h1) == null);
+    try testing.expectEqual(@as(usize, 1), ref.rows);
+    try testing.expectEqual(@as(usize, 80), @as(usize, ref.screen.pages.cols));
+
+    ref2.release();
+    try testing.expectEqual(@as(usize, 1), ref.rows);
+    // Last release frees (testing.allocator flags a leak otherwise).
+    ref.release();
+
+    // Same via clear.
+    const s2 = try alloc.create(Screen);
+    s2.* = try .init(alloc, .default);
+    const h2 = try set.append(alloc, .{ .screen = s2, .rows = 2 });
+    const ref3 = set.acquire(h2).?;
+    set.clear(alloc);
+    try testing.expectEqual(@as(usize, 0), set.count());
+    try testing.expectEqual(@as(usize, 2), ref3.rows);
+    ref3.release();
+}
+
+test "BlockSet acquire is refused while writing" {
+    const alloc = testing.allocator;
+    var set: BlockSet = .{};
+    defer set.deinit(alloc);
+
+    const s1 = try alloc.create(Screen);
+    s1.* = try .init(alloc, .default);
+    const h1 = try set.append(alloc, .{ .screen = s1, .rows = 1 });
+
+    const block = set.getPtr(h1).?;
+    set.beginWrite(block);
+    try testing.expect(set.acquire(h1) == null);
+    set.endWrite(block);
+    const ref = set.acquire(h1).?;
+    ref.release();
+}
