+/// Returns the number of rows up to and including the last row that has
+/// any text. Rows with only styling (e.g. background color) count as
+/// blank, matching the blank definition used by resize trimming. Used by
+/// Terminal.finishBlock to record the logical row count of a frozen block
+/// without mutating the page structure.
+///
+/// Unlike trailingBlankLines this is not capped at CellCountInt, since
+/// scrollback row counts exceed it.
+pub fn contentRows(self: *const PageList) usize {
+    var blank: usize = 0;
+
+    // Go through our pages backwards since we're counting trailing blanks.
+    var it = self.pages.last;
+    while (it) |node| : (it = node.prev) {
+        const page = node.page();
+        const len = node.rows();
+        const rows_slice = page.rows.ptr(page.memory)[0..len];
+        for (0..len) |i| {
+            const rev_i = len - i - 1;
+            const cells = rows_slice[rev_i].cells.ptr(page.memory)[0..node.cols()];
+            if (pagepkg.Cell.hasTextAny(cells)) return self.total_rows - blank;
+            blank += 1;
+        }
+    }
+
+    return 0;
+}
